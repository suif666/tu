{
  "manifest_version": 3,
  "name": "[自备]",
  "version": "3.0.0",
  "description": "面向老旧电脑的网页减负：① 可自选编码（自动 / 优先 AVC / 优先 HEVC / 优先 AV1），让网站回退到有 GPU 硬解的格式；② 削减网页动态效果与滚动开销，降低 CPU/GPU 负载。",
  "author": "suif",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "inject.js"
      ],
      "css": [
        "reduce.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}
